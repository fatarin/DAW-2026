        <UserObject label="  &lt;&lt;Reglas de Negocio — Apadrinamiento&gt;&gt;&#xa;  1. Un animal solo puede tener UN APADRINAMIENTO&#xa;     con estado ACTIVO simultáneamente.&#xa;  2. Un animal puede tener múltiples&#xa;     apadrinamientos históricos.&#xa;  10. Un animal adoptado no puede recibir&#xa;      un nuevo apadrinamiento activo." plantUmlId="note_281" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;fontFamily=Arial;" plantUmlBaseValue="  &lt;&lt;Reglas de Negocio — Apadrinamiento&gt;&gt;&#xa;  1. Un animal solo puede tener UN APADRINAMIENTO&#xa;     con estado ACTIVO simultáneamente.&#xa;  2. Un animal puede tener múltiples&#xa;     apadrinamientos históricos.&#xa;  10. Un animal adoptado no puede recibir&#xa;      un nuevo apadrinamiento activo." id="2Wrog6u-oQ5swqO5EDTG-281">
          <mxCell parent="2Wrog6u-oQ5swqO5EDTG-1" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;fontFamily=Arial;" vertex="1">
            <mxGeometry height="136" width="360" x="207.58999999999997" y="1143" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="noteptr_282" plantUmlBaseStyle="shape=triangle;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;shadow=0;fontFamily=Arial;direction=south;" plantUmlBaseValue="" id="2Wrog6u-oQ5swqO5EDTG-282">
