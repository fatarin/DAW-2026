          </mxCell>
        </UserObject>
        <UserObject label="  &lt;&lt;Reglas de Negocio — Tratamientos&gt;&gt;&#xa;  4. Un tratamiento puede recibir aportaciones&#xa;     de múltiples usuarios.&#xa;  5. El importe recaudado se calcula sumando&#xa;     las aportaciones asociadas a pagos COMPLETADOS.&#xa;  6. NO almacenar &quot;importe_recaudado&quot; en TRATAMIENTO." plantUmlId="note_283" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;fontFamily=Arial;" plantUmlBaseValue="  &lt;&lt;Reglas de Negocio — Tratamientos&gt;&gt;&#xa;  4. Un tratamiento puede recibir aportaciones&#xa;     de múltiples usuarios.&#xa;  5. El importe recaudado se calcula sumando&#xa;     las aportaciones asociadas a pagos COMPLETADOS.&#xa;  6. NO almacenar &quot;importe_recaudado&quot; en TRATAMIENTO." id="2Wrog6u-oQ5swqO5EDTG-283">
          <mxCell parent="2Wrog6u-oQ5swqO5EDTG-1" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;fontFamily=Arial;" vertex="1">
            <mxGeometry height="118" width="389" x="457.345" y="1578" as="geometry" />
          </mxCell>
