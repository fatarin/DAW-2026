<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="sWdy5m8SSjfiqk6uy5SS">
    <mxGraphModel dx="1406" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 80\nskinparam defaultFontName Arial\nskinparam shadowing false\nskinparam packageStyle rectangle\n\ntitle Diagrama Entidad-Relación — PAWLINK\n\n&#39; =========================================================\n&#39; ESTILOS DIFERENCIADOS\n&#39; =========================================================\nskinparam entity {\n    BackgroundColor #FFFFFF\n    BorderColor #333333\n    ArrowColor #555555\n}\n\n&#39; =========================================================\n&#39; ANILLO CENTRAL — ANIMAL (entidad núcleo)\n&#39; =========================================================\nentity \&quot;ANIMAL\&quot; as ANIMAL {\n    * id_animal : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n    nombre : VARCHAR\n    especie : animal_especie\n    raza : VARCHAR\n    sexo : animal_sexo\n    fecha_nacimiento : DATE\n    edad_aproximada : VARCHAR\n    descripcion : TEXT\n    historia : TEXT\n    motivo_necesidad : TEXT\n    estado : animal_estado\n    fecha_entrada : DATE\n    fecha_publicacion : TIMESTAMP\n    fecha_creacion : TIMESTAMP\n    fecha_actualizacion : TIMESTAMP\n}\n\n&#39; =========================================================\n&#39; ANILLO 1 — Entidades directamente vinculadas a ANIMAL\n&#39; =========================================================\nentity \&quot;PROTECTORA\&quot; as PROTECTORA {\n    * id_protectora : UUID &lt;&lt;PK&gt;&gt;\n    --\n    nombre : VARCHAR\n    nombre_legal : VARCHAR\n    tipo : protectora_tipo\n    nif_cif : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n    anio_fundacion : INTEGER\n    descripcion : TEXT\n    email : VARCHAR\n    telefono : VARCHAR\n    web : VARCHAR\n    redes_sociales : JSON\n    direccion : VARCHAR\n    municipio : VARCHAR\n    provincia : VARCHAR\n    codigo_postal : VARCHAR\n    ubicacion_publica : ubicacion_publica\n    logo_url : VARCHAR\n    estado_verificacion : verificacion_estado\n    fecha_registro : TIMESTAMP\n}\n\nentity \&quot;ANIMAL_IMAGEN\&quot; as ANIMAL_IMAGEN {\n    * id_imagen : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    url : VARCHAR\n    orden : INTEGER\n    es_principal : BOOLEAN\n    fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;APADRINAMIENTO\&quot; as APADRINAMIENTO {\n    * id_apadrinamiento : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    importe_mensual : DECIMAL\n    estado : apadrinamiento_estado\n    fecha_inicio : TIMESTAMP\n    fecha_fin : TIMESTAMP\n    motivo_fin : VARCHAR\n}\n\nentity \&quot;TRATAMIENTO\&quot; as TRATAMIENTO {\n    * id_tratamiento : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    titulo : VARCHAR\n    descripcion : TEXT\n    motivo : TEXT\n    objetivo_economico : DECIMAL\n    fecha_inicio : DATE\n    fecha_fin : DATE\n    estado : tratamiento_estado\n    informacion_veterinaria : TEXT\n}\n\nentity \&quot;REGALO\&quot; as REGALO {\n    * id_regalo : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    * id_producto : UUID &lt;&lt;FK&gt;&gt;\n    * id_pago : UUID &lt;&lt;FK&gt;&gt;\n    precio : DECIMAL &lt;&lt;histórico&gt;&gt;\n    estado : regalo_estado\n    fecha_compra : TIMESTAMP\n    fecha_entrega : TIMESTAMP\n}\n\nentity \&quot;ACTUALIZACION\&quot; as ACTUALIZACION {\n    * id_actualizacion : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    * id_usuario_autor : UUID &lt;&lt;FK&gt;&gt;\n    titulo : VARCHAR\n    contenido : TEXT\n    visibilidad : actualizacion_visibilidad\n    estado : actualizacion_estado\n    fecha_publicacion : TIMESTAMP\n    fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;ADOPCION\&quot; as ADOPCION {\n    * id_adopcion : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_animal : UUID &lt;&lt;FK&gt;&gt;\n    fecha_adopcion : DATE\n    observaciones : TEXT\n    fecha_registro : TIMESTAMP\n}\n\n&#39; =========================================================\n&#39; ENTIDADES ASOCIATIVAS (destacadas visualmente)\n&#39; =========================================================\nentity \&quot;SEGUIMIENTO_ANIMAL\\n&lt;&lt;asociativa&gt;&gt;\&quot; as SEGUIMIENTO_ANIMAL #E8F4FD {\n    * id_usuario : UUID &lt;&lt;PK, FK&gt;&gt;\n    * id_animal : UUID &lt;&lt;PK, FK&gt;&gt;\n    --\n    fecha_inicio : TIMESTAMP\n    fecha_fin : TIMESTAMP\n}\n\nentity \&quot;PRODUCTO_ANIMAL\\n&lt;&lt;asociativa&gt;&gt;\&quot; as PRODUCTO_ANIMAL #E8F4FD {\n    * id_producto : UUID &lt;&lt;PK, FK&gt;&gt;\n    * id_animal : UUID &lt;&lt;PK, FK&gt;&gt;\n    --\n    recomendado : BOOLEAN\n    motivo : TEXT\n    fecha_creacion : TIMESTAMP\n}\n\n&#39; =========================================================\n&#39; ANILLO 2 — Entidades externas\n&#39; =========================================================\nentity \&quot;USUARIO\&quot; as USUARIO {\n    * id_usuario : UUID &lt;&lt;PK&gt;&gt;\n    --\n    nombre : VARCHAR\n    apellidos : VARCHAR\n    email : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n    password_hash : VARCHAR\n    telefono : VARCHAR\n    foto_url : VARCHAR\n    email_verificado : BOOLEAN\n    estado : usuario_estado\n    fecha_registro : TIMESTAMP\n    fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;APORTACION_TRATAMIENTO\&quot; as APORTACION_TRATAMIENTO {\n    * id_aportacion : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_tratamiento : UUID &lt;&lt;FK&gt;&gt;\n    * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n    * id_pago : UUID &lt;&lt;FK&gt;&gt;\n    importe : DECIMAL\n    fecha_aportacion : TIMESTAMP\n}\n\nentity \&quot;PAGO\&quot; as PAGO {\n    * id_pago : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n    tipo : pago_tipo\n    estado : pago_estado\n    importe : DECIMAL\n    moneda : VARCHAR\n    proveedor : VARCHAR\n    id_externo : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n    fecha_creacion : TIMESTAMP\n    fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;PRODUCTO_REGALO\&quot; as PRODUCTO_REGALO {\n    * id_producto : UUID &lt;&lt;PK&gt;&gt;\n    --\n    nombre : VARCHAR\n    descripcion : TEXT\n    categoria : producto_categoria\n    precio : DECIMAL\n    stock : INTEGER\n    imagen_url : VARCHAR\n    activo : BOOLEAN\n    fecha_creacion : TIMESTAMP\n    fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;NOTIFICACION\&quot; as NOTIFICACION {\n    * id_notificacion : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n    id_actualizacion : UUID &lt;&lt;FK, NULL&gt;&gt;\n    tipo : VARCHAR\n    titulo : VARCHAR\n    mensaje : TEXT\n    leida : BOOLEAN\n    fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;CUENTA_BANCARIA_PROTECTORA\&quot; as CUENTA_BANCARIA {\n    * id_cuenta : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n    titular : VARCHAR\n    iban : VARCHAR\n    estado_verificacion : verificacion_estado\n    fecha_creacion : TIMESTAMP\n    fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;USUARIO_PROTECTORA\\n&lt;&lt;asociativa&gt;&gt;\&quot; as USUARIO_PROTECTORA #E8F4FD {\n    * id_usuario : UUID &lt;&lt;PK, FK&gt;&gt;\n    * id_protectora : UUID &lt;&lt;PK, FK&gt;&gt;\n    --\n    rol : rol_protectora\n    estado : VARCHAR\n    fecha_alta : TIMESTAMP\n}\n\nentity \&quot;VERIFICACION_PROTECTORA\&quot; as VERIFICACION {\n    * id_verificacion : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n    id_revisor : UUID &lt;&lt;FK, NULL&gt;&gt;\n    estado : verificacion_estado\n    observaciones : TEXT\n    fecha_inicio : TIMESTAMP\n    fecha_resolucion : TIMESTAMP\n}\n\n&#39; =========================================================\n&#39; RELACIONES — ANILLO 1 (alrededor de ANIMAL)\n&#39; =========================================================\nPROTECTORA ||--o{ ANIMAL : \&quot;registra\&quot;\nANIMAL ||--o{ ANIMAL_IMAGEN : \&quot;tiene\&quot;\nANIMAL ||--o{ APADRINAMIENTO : \&quot;recibe\&quot;\nANIMAL ||--o{ TRATAMIENTO : \&quot;requiere\&quot;\nANIMAL ||--o{ REGALO : \&quot;recibe\&quot;\nANIMAL ||--o{ ACTUALIZACION : \&quot;publica\&quot;\nANIMAL ||--o| ADOPCION : \&quot;logra\&quot;\nANIMAL }o--o{ SEGUIMIENTO_ANIMAL : \&quot;es seguido por\&quot;\nANIMAL }o--o{ PRODUCTO_ANIMAL : \&quot;compatible con\&quot;\n\n&#39; =========================================================\n&#39; RELACIONES — ANILLO 2 (conexiones externas)\n&#39; =========================================================\nUSUARIO ||--o{ APADRINAMIENTO : \&quot;apadrina\&quot;\nUSUARIO ||--o{ APORTACION_TRATAMIENTO : \&quot;aporta\&quot;\nUSUARIO ||--o{ REGALO : \&quot;envía\&quot;\nUSUARIO ||--o{ ACTUALIZACION : \&quot;escribe\&quot;\nUSUARIO ||--o{ NOTIFICACION : \&quot;recibe\&quot;\nUSUARIO ||--o{ PAGO : \&quot;realiza\&quot;\nUSUARIO }o--o{ USUARIO_PROTECTORA : \&quot;pertenece a\&quot;\n\nAPORTACION_TRATAMIENTO }o--|| TRATAMIENTO : \&quot;financia\&quot;\nAPORTACION_TRATAMIENTO }o--|| PAGO : \&quot;respalda\&quot;\n\nPRODUCTO_REGALO ||--o{ REGALO : \&quot;se regala\&quot;\nPRODUCTO_REGALO }o--o{ PRODUCTO_ANIMAL : \&quot;recomendado para\&quot;\n\nACTUALIZACION ||--o{ NOTIFICACION : \&quot;genera\&quot;\n\nPROTECTORA ||--o{ CUENTA_BANCARIA : \&quot;posee\&quot;\nPROTECTORA }o--o{ USUARIO_PROTECTORA : \&quot;tiene equipo\&quot;\nPROTECTORA ||--o{ VERIFICACION : \&quot;solicita\&quot;\n\nUSUARIO ||--o{ VERIFICACION : \&quot;revisa (0..1)\&quot;\n\n&#39; =========================================================\n&#39; NOTAS — REGLAS DE NEGOCIO\n&#39; =========================================================\nnote top of APADRINAMIENTO\n  &lt;&lt;Reglas de Negocio — Apadrinamiento&gt;&gt;\n  1. Un animal solo puede tener UN APADRINAMIENTO\n     con estado ACTIVO simultáneamente.\n  2. Un animal puede tener múltiples\n     apadrinamientos históricos.\n  10. Un animal adoptado no puede recibir\n      un nuevo apadrinamiento activo.\nend note\n\nnote bottom of TRATAMIENTO\n  &lt;&lt;Reglas de Negocio — Tratamientos&gt;&gt;\n  4. Un tratamiento puede recibir aportaciones\n     de múltiples usuarios.\n  5. El importe recaudado se calcula sumando\n     las aportaciones asociadas a pagos COMPLETADOS.\n  6. NO almacenar \&quot;importe_recaudado\&quot; en TRATAMIENTO.\nend note\n\nnote right of REGALO\n  &lt;&lt;Reglas de Negocio — Regalos&gt;&gt;\n  7. Un producto puede regalarse a múltiples\n     animales y múltiples veces.\n  8. REGALO conserva el precio histórico\n     pagado mediante su atributo \&quot;precio\&quot;.\nend note\n\nnote left of PROTECTORA\n  &lt;&lt;Reglas de Negocio — Protectoras&gt;&gt;\n  9. Una protectora debe estar VERIFICADA\n     antes de poder publicar animales\n     públicamente.\nend note\n\nnote bottom of ADOPCION\n  &lt;&lt;Reglas de Negocio — Adopción&gt;&gt;\n  11. Al registrarse una adopción,\n      el apadrinamiento activo\n      debe finalizar automáticamente.\nend note\n\nnote top of ACTUALIZACION\n  &lt;&lt;Reglas de Negocio — Autoría&gt;&gt;\n  12. El autor de una ACTUALIZACION debe\n      pertenecer a la PROTECTORA que\n      gestiona el ANIMAL.\nend note\n\nnote as RN_GLOBALES\n  &lt;&lt;Reglas de Negocio Globales&gt;&gt;\n  3. Un animal puede tener simultáneamente:\n     - un PawMate activo\n     - múltiples tratamientos\n     - múltiples aportaciones\n     - múltiples regalos\n     - múltiples seguidores\n     - múltiples actualizaciones\n  13. Las tres formas de ayuda son independientes:\n     - APADRINAMIENTO (PawMate)\n     - APORTACION_TRATAMIENTO (PawCare)\n     - REGALO (PawGift)\n  14. PawMate, PawCare y PawGift NO son\n      entidades independientes.\nend note\n\nRN_GLOBALES ..&gt; ANIMAL : referencia\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2Wrog6u-oQ5swqO5EDTG-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
