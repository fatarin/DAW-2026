        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama Entidad-Relacion - PAWLINK v1.2\n\nentity \&quot;MASCOTA\&quot; as MASCOTA\nentity \&quot;PROTECTORA\&quot; as PROTECTORA\nentity \&quot;USUARIO\&quot; as USUARIO\nentity \&quot;MASCOTA_IMAGEN\&quot; as MASCOTA_IMAGEN\nentity \&quot;APADRINAMIENTO\&quot; as APADRINAMIENTO\nentity \&quot;TRATAMIENTO\&quot; as TRATAMIENTO\nentity \&quot;PAGO\&quot; as PAGO\nentity \&quot;APORTACION_TRATAMIENTO\&quot; as APORTACION_TRATAMIENTO\nentity \&quot;PRODUCTO_REGALO\&quot; as PRODUCTO_REGALO\nentity \&quot;PRODUCTO_MASCOTA\&quot; as PRODUCTO_MASCOTA\nentity \&quot;REGALO\&quot; as REGALO\nentity \&quot;SEGUIMIENTO_MASCOTA\&quot; as SEGUIMIENTO_MASCOTA\nentity \&quot;ACTUALIZACION\&quot; as ACTUALIZACION\nentity \&quot;NOTIFICACION\&quot; as NOTIFICACION\nentity \&quot;CUENTA_BANCARIA_PROTECTORA\&quot; as CUENTA_BANCARIA\nentity \&quot;VERIFICACION_PROTECTORA\&quot; as VERIFICACION\n\nPROTECTORA ||--o{ MASCOTA : \&quot;Registra (1,n)\&quot;\nMASCOTA ||--o{ MASCOTA_IMAGEN : \&quot;Tiene (1,n)\&quot;\nMASCOTA ||--o{ TRATAMIENTO : \&quot;Requiere (1,n)\&quot;\nMASCOTA ||--o{ REGALO : \&quot;Recibe (1,n)\&quot;\nMASCOTA ||--o{ ACTUALIZACION : \&quot;Publica (1,n)\&quot;\nMASCOTA ||--o{ APADRINAMIENTO : \&quot;PawMate (1,n)\&quot;\nMASCOTA ||--o{ SEGUIMIENTO_MASCOTA : \&quot;Seguido (1,n)\&quot;\nMASCOTA ||--o{ PRODUCTO_MASCOTA : \&quot;Compatible (1,n)\&quot;\n\nAPADRINAMIENTO }o--|| USUARIO : \&quot;Apadrina (1,1)\&quot;\nSEGUIMIENTO_MASCOTA }o--|| USUARIO : \&quot;Sigue (1,n)\&quot;\nPRODUCTO_MASCOTA }o--|| PRODUCTO_REGALO : \&quot;Producto (1,n)\&quot;\n\nTRATAMIENTO ||--o{ APORTACION_TRATAMIENTO : \&quot;Recibe (1,n)\&quot;\nAPORTACION_TRATAMIENTO }o--|| USUARIO : \&quot;Aporta (1,1)\&quot;\nAPORTACION_TRATAMIENTO }o--|| PAGO : \&quot;Respalda (1,1)\&quot;\n\nREGALO }o--|| USUARIO : \&quot;Envia (1,1)\&quot;\nREGALO }o--|| PRODUCTO_REGALO : \&quot;Se regala (1,n)\&quot;\n\nUSUARIO ||--o{ PAGO : \&quot;Realiza (1,n)\&quot;\n\nACTUALIZACION ||--o{ NOTIFICACION : \&quot;Genera (1,n)\&quot;\nNOTIFICACION }o--|| USUARIO : \&quot;Recibe (1,1)\&quot;\nACTUALIZACION }o--|| USUARIO : \&quot;Autor (1,1)\&quot;\n\nPROTECTORA ||--o{ CUENTA_BANCARIA : \&quot;Posee (1,n)\&quot;\nPROTECTORA ||--o{ VERIFICACION : \&quot;Solicita (1,n)\&quot;\nVERIFICACION }o--o| USUARIO : \&quot;Revisa (0,1)\&quot;\n\nnote top of MASCOTA\n  Entidad CENTRAL\n  Sin entidad ADOPCION:\n  se gestiona via estado\nend note\n\nnote right of APADRINAMIENTO\n  Solo 1 ACTIVO por mascota\nend note\n\nnote left of TRATAMIENTO\n  Sin importe_recaudado\nend note\n\nnote bottom of REGALO\n  Precio historico\nend note\n\nnote top of PROTECTORA\n  Debe estar VERIFICADA\n  para publicar mascotas\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="X647Rr7-j4unrD0SDb3Z-1">
