  <diagram name="Página-1" id="JC5bfqFv023cmOMjvac_">
    <mxGraphModel dx="2038" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama Relacional - PAWLINK v1.2\n\nskinparam linetype ortho\n\n&#39; =========================================================\n&#39; ENTIDADES CON ATRIBUTOS\n&#39; =========================================================\n\nentity \&quot;USUARIO\&quot; as USUARIO {\n  * id_usuario : UUID &lt;&lt;PK&gt;&gt;\n  --\n  nombre : VARCHAR\n  apellidos : VARCHAR\n  email : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n  password_hash : VARCHAR\n  telefono : VARCHAR\n  foto_url : VARCHAR\n  email_verificado : BOOLEAN\n  estado : VARCHAR\n  fecha_creacion : TIMESTAMP\n  fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;PROTECTORA\&quot; as PROTECTORA {\n  * id_protectora : UUID &lt;&lt;PK&gt;&gt;\n  --\n  nombre : VARCHAR\n  nombre_legal : VARCHAR\n  tipo : VARCHAR\n  nif_cif : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n  anio_fundacion : INTEGER\n  descripcion : TEXT\n  email_publico : VARCHAR\n  telefono_publico : VARCHAR\n  web : VARCHAR\n  redes_sociales : JSON\n  direccion : VARCHAR\n  municipio : VARCHAR\n  provincia : VARCHAR\n  codigo_postal : VARCHAR\n  ubicacion_publica : VARCHAR\n  logo_url : VARCHAR\n  estado_verificacion : VARCHAR\n  fecha_creacion : TIMESTAMP\n  fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;CUENTA_BANCARIA_PROTECTORA\&quot; as CUENTA_BANCARIA {\n  * id_cuenta : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n  titular : VARCHAR\n  iban : VARCHAR\n  estado_verificacion : VARCHAR\n  fecha_creacion : TIMESTAMP\n  fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;VERIFICACION_PROTECTORA\&quot; as VERIFICACION {\n  * id_verificacion : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n  id_revisor : UUID &lt;&lt;FK, NULL&gt;&gt;\n  estado : VARCHAR\n  observaciones : TEXT\n  fecha_inicio : TIMESTAMP\n  fecha_resolucion : TIMESTAMP\n}\n\nentity \&quot;MASCOTA\&quot; as MASCOTA {\n  * id_mascota : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_protectora : UUID &lt;&lt;FK&gt;&gt;\n  nombre : VARCHAR\n  especie : VARCHAR\n  raza : VARCHAR\n  sexo : VARCHAR\n  fecha_nacimiento : DATE\n  edad_aproximada : VARCHAR\n  descripcion : TEXT\n  historia : TEXT\n  motivo_necesidad : TEXT\n  estado : VARCHAR\n  fecha_entrada : DATE\n  fecha_publicacion : TIMESTAMP\n  fecha_creacion : TIMESTAMP\n  fecha_actualizacion : TIMESTAMP\n}\n\nentity \&quot;MASCOTA_IMAGEN\&quot; as MASCOTA_IMAGEN {\n  * id_imagen : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_mascota : UUID &lt;&lt;FK&gt;&gt;\n  url : VARCHAR\n  orden : INTEGER\n  es_principal : BOOLEAN\n  fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;APADRINAMIENTO\&quot; as APADRINAMIENTO {\n  * id_apadrinamiento : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n  * id_mascota : UUID &lt;&lt;FK&gt;&gt;\n  * id_pago : UUID &lt;&lt;FK&gt;&gt;\n  importe_mensual : DECIMAL\n  estado : VARCHAR\n  fecha_inicio : TIMESTAMP\n  fecha_fin : TIMESTAMP\n  motivo_fin : VARCHAR\n}\n\nentity \&quot;TRATAMIENTO\&quot; as TRATAMIENTO {\n  * id_tratamiento : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_mascota : UUID &lt;&lt;FK&gt;&gt;\n  titulo : VARCHAR\n  descripcion : TEXT\n  motivo : TEXT\n  importe_objetivo : DECIMAL\n  fecha_inicio : DATE\n  fecha_fin : DATE\n  estado : VARCHAR\n  informacion_veterinaria : TEXT\n}\n\nentity \&quot;APORTACION_TRATAMIENTO\&quot; as APORTACION_TRATAMIENTO {\n  * id_aportacion : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_tratamiento : UUID &lt;&lt;FK&gt;&gt;\n  * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n  * id_pago : UUID &lt;&lt;FK&gt;&gt;\n  importe : DECIMAL\n  fecha : TIMESTAMP\n}\n\nentity \&quot;PAGO\&quot; as PAGO {\n  * id_pago : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n  importe : DECIMAL\n  moneda : VARCHAR\n  proveedor : VARCHAR\n  id_externo_proveedor : VARCHAR &lt;&lt;UNIQUE&gt;&gt;\n  estado : VARCHAR\n  fecha_creacion : TIMESTAMP\n  fecha_completado : TIMESTAMP\n}\n\nentity \&quot;PRODUCTO_REGALO\&quot; as PRODUCTO_REGALO {\n  * id_producto : UUID &lt;&lt;PK&gt;&gt;\n  --\n  nombre : VARCHAR\n  descripcion : TEXT\n  categoria : VARCHAR\n  precio : DECIMAL\n  stock : INTEGER\n  imagen_url : VARCHAR\n  activo : BOOLEAN\n  fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;PRODUCTO_MASCOTA\&quot; as PRODUCTO_MASCOTA {\n  * id_producto : UUID &lt;&lt;PK, FK&gt;&gt;\n  * id_mascota : UUID &lt;&lt;PK, FK&gt;&gt;\n  --\n  recomendado : BOOLEAN\n  motivo : TEXT\n  fecha_asociacion : TIMESTAMP\n}\n\nentity \&quot;REGALO\&quot; as REGALO {\n  * id_regalo : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n  * id_mascota : UUID &lt;&lt;FK&gt;&gt;\n  * id_producto : UUID &lt;&lt;FK&gt;&gt;\n  * id_pago : UUID &lt;&lt;FK&gt;&gt;\n  precio : DECIMAL &lt;&lt;historico&gt;&gt;\n  estado : VARCHAR\n  fecha_compra : TIMESTAMP\n  fecha_envio : TIMESTAMP\n  fecha_recepcion : TIMESTAMP\n}\n\nentity \&quot;SEGUIMIENTO_MASCOTA\&quot; as SEGUIMIENTO_MASCOTA {\n  * id_usuario : UUID &lt;&lt;PK, FK&gt;&gt;\n  * id_mascota : UUID &lt;&lt;PK, FK&gt;&gt;\n  --\n  fecha_inicio : TIMESTAMP\n  fecha_fin : TIMESTAMP\n}\n\nentity \&quot;ACTUALIZACION\&quot; as ACTUALIZACION {\n  * id_actualizacion : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_mascota : UUID &lt;&lt;FK&gt;&gt;\n  * id_usuario_autor : UUID &lt;&lt;FK&gt;&gt;\n  titulo : VARCHAR\n  contenido : TEXT\n  visibilidad : VARCHAR\n  estado : VARCHAR\n  fecha_publicacion : TIMESTAMP\n  fecha_creacion : TIMESTAMP\n}\n\nentity \&quot;NOTIFICACION\&quot; as NOTIFICACION {\n  * id_notificacion : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * id_usuario : UUID &lt;&lt;FK&gt;&gt;\n  id_actualizacion : UUID &lt;&lt;FK, NULL&gt;&gt;\n  tipo : VARCHAR\n  titulo : VARCHAR\n  mensaje : TEXT\n  leida : BOOLEAN\n  fecha_creacion : TIMESTAMP\n}\n\n&#39; =========================================================\n&#39; RELACIONES\n&#39; =========================================================\n\n&#39; PROTECTORA - MASCOTA\nPROTECTORA ||--o{ MASCOTA : \&quot;1:N Registra\&quot;\n\n&#39; PROTECTORA - CUENTA_BANCARIA\nPROTECTORA ||--o{ CUENTA_BANCARIA : \&quot;1:N Posee\&quot;\n\n&#39; PROTECTORA - VERIFICACION\nPROTECTORA ||--o{ VERIFICACION : \&quot;1:N Solicita\&quot;\nVERIFICACION }o--o| USUARIO : \&quot;0..1:N Revisa\&quot;\n\n&#39; MASCOTA - MASCOTA_IMAGEN\nMASCOTA ||--o{ MASCOTA_IMAGEN : \&quot;1:N Tiene\&quot;\n\n&#39; MASCOTA - APADRINAMIENTO\nMASCOTA ||--o{ APADRINAMIENTO : \&quot;1:N PawMate\&quot;\nAPADRINAMIENTO }o--|| USUARIO : \&quot;N:1 Apadrina\&quot;\nAPADRINAMIENTO }o--|| PAGO : \&quot;N:1 Paga\&quot;\n\n&#39; MASCOTA - TRATAMIENTO\nMASCOTA ||--o{ TRATAMIENTO : \&quot;1:N Requiere\&quot;\nTRATAMIENTO ||--o{ APORTACION_TRATAMIENTO : \&quot;1:N Recibe\&quot;\nAPORTACION_TRATAMIENTO }o--|| USUARIO : \&quot;N:1 Aporta\&quot;\nAPORTACION_TRATAMIENTO }o--|| PAGO : \&quot;N:1 Respalda\&quot;\n\n&#39; MASCOTA - REGALO\nMASCOTA ||--o{ REGALO : \&quot;1:N Recibe\&quot;\nREGALO }o--|| USUARIO : \&quot;N:1 Envía\&quot;\nREGALO }o--|| PRODUCTO_REGALO : \&quot;N:1 Producto\&quot;\nREGALO }o--|| PAGO : \&quot;N:1 Paga\&quot;\n\n&#39; PRODUCTO_REGALO - PRODUCTO_MASCOTA\nPRODUCTO_REGALO ||--o{ PRODUCTO_MASCOTA : \&quot;1:N Compatible\&quot;\nPRODUCTO_MASCOTA }o--|| MASCOTA : \&quot;N:1 Mascota\&quot;\n\n&#39; MASCOTA - SEGUIMIENTO\nMASCOTA ||--o{ SEGUIMIENTO_MASCOTA : \&quot;1:N Seguido\&quot;\nSEGUIMIENTO_MASCOTA }o--|| USUARIO : \&quot;N:1 Sigue\&quot;\n\n&#39; MASCOTA - ACTUALIZACION\nMASCOTA ||--o{ ACTUALIZACION : \&quot;1:N Publica\&quot;\nACTUALIZACION }o--|| USUARIO : \&quot;N:1 Autor\&quot;\n\n&#39; ACTUALIZACION - NOTIFICACION\nACTUALIZACION ||--o{ NOTIFICACION : \&quot;1:N Genera\&quot;\nNOTIFICACION }o--|| USUARIO : \&quot;N:1 Recibe\&quot;\n\n&#39; USUARIO - PAGO\nUSUARIO ||--o{ PAGO : \&quot;1:N Realiza\&quot;\n\n&#39; =========================================================\n&#39; NOTAS - REGLAS DE NEGOCIO\n&#39; =========================================================\n\nnote top of MASCOTA\n  Entidad CENTRAL\n  Estados: BORRADOR, PENDIENTE_REVISION,\n  PUBLICADO, PAUSADO, ADOPTADO, NO_DISPONIBLE\n  (Sin entidad ADOPCION: se gestiona via estado)\nend note\n\nnote right of APADRINAMIENTO\n  REGLA: Solo 1 ACTIVO por mascota.\n  Restricción única: (id_mascota, estado=&#39;ACTIVO&#39;)\nend note\n\nnote left of TRATAMIENTO\n  Sin \&quot;importe_recaudado\&quot;.\n  Se calcula: SUM(aportaciones) WHERE pago.estado=&#39;COMPLETADO&#39;\nend note\n\nnote bottom of REGALO\n  \&quot;precio\&quot; = precio histórico pagado\n  en el momento del PawGift\nend note\n\nnote top of PROTECTORA\n  Debe estar VERIFICADA (estado=&#39;VERIFICADA&#39;)\n  antes de publicar mascotas\nend note\n\nnote right of PRODUCTO_MASCOTA\n  Tabla intermedia N:M\n  Define compatibilidad entre\n  productos y mascotas\nend note\n\nnote bottom of SEGUIMIENTO_MASCOTA\n  Tabla intermedia N:M\n  Usuarios que siguen mascotas\nend note\n\nnote left of PAGO\n  Un pago se vincula a UNA sola operación:\n  - APADRINAMIENTO, o\n  - APORTACION_TRATAMIENTO, o\n  - REGALO\n  (id_externo_proveedor UNIQUE)\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vWcKLcRGpm5_KriFcw0l-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
